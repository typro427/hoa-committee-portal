// HOA Committee Portal — database schema
// Historical records (meetings, minutes, revisions, tasks, audit logs) are never hard-deleted.
// Members and committees are deactivated/archived instead of removed.

generator client {
  provider   = "prisma-client-js"
  // Rust-free client: queries run through the node-postgres driver adapter (@prisma/adapter-pg).
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

/// Subscription state of an HOA on the platform.
enum OrgStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum CommitteeStatus {
  ACTIVE
  ARCHIVED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum CommitteeRole {
  CHAIR
  SECRETARY
  MEMBER
}

enum MeetingType {
  REGULAR
  SPECIAL
  ANNUAL_PLANNING
  EMERGENCY
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  POSTPONED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  GUEST
}

enum AgendaSection {
  CALL_TO_ORDER
  ROLL_CALL
  APPROVAL_OF_PREVIOUS_MINUTES
  OLD_BUSINESS
  NEW_BUSINESS
  COMMITTEE_REPORTS
  PROJECT_UPDATES
  RECOMMENDATIONS
  OTHER_BUSINESS
  ADJOURNMENT
}

enum MinutesStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
}

enum MotionOutcome {
  PASSED
  FAILED
  TABLED
  WITHDRAWN
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_ON_INFORMATION
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ArbStatus {
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO_NEEDED
  APPROVED
  APPROVED_WITH_CONDITIONS
  DENIED
  CONSTRUCTION_IN_PROGRESS
  AWAITING_BUILDING_PERMIT
  COMPLETED
}

enum ArbProjectType {
  NEW_CONSTRUCTION
  ADDITION
  DECK_OR_PATIO
  FENCE
  POOL_OR_SPA
  SHED_OR_ACCESSORY
  DRIVEWAY
  ROOF
  EXTERIOR_PAINT
  LANDSCAPING
  SOLAR
  OTHER
}

enum ArbDocType {
  PLAT_PLAN
  ELEVATIONS
  UTILITY_LOCATIONS
  BUILDING_PERMIT
  OTHER
}

enum UtilityPlacement {
  OVERHEAD
  BURIED
  NOT_APPLICABLE
  UNKNOWN
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

// ---------- Models ----------

model Organization {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String   @unique
  logoUrl               String?  @map("logo_url")
  timezone              String   @default("America/New_York")
  tagline               String?  @default("Organized Committees. Better Decisions.")
  sessionTimeoutMinutes Int      @default(60) @map("session_timeout_minutes")
  status                OrgStatus @default(ACTIVE)
  trialEndsAt           DateTime? @map("trial_ends_at")
  /// Billing / account contact for the platform owner.
  contactName           String?   @map("contact_name")
  contactEmail          String?   @map("contact_email")
  ownerNotes            String?   @map("owner_notes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  committees Committee[]
  members    Member[]
  auditLogs  AuditLog[]
  admins     AdminUser[]

  @@map("organizations")
}

model Committee {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String
  description    String?
  status         CommitteeStatus @default(ACTIVE)
  /// This committee reviews architectural (ARB) requests submitted by residents.
  handlesArbRequests Boolean     @default(false) @map("handles_arb_requests")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  CommitteeMembership[]
  meetings     Meeting[]
  tasks        Task[]
  documents    Document[]
  folders      DocumentFolder[]
  arbRequests  ArbRequest[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("committees")
}

model Member {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  email          String?
  phone          String?
  /// Argon2id hash of the PIN. Never returned from any query used by the UI.
  pinHash        String?      @map("pin_hash")
  /// Keyed HMAC-SHA256 of the PIN (PIN_HASH_SECRET) for O(1) lookup; the Argon2id hash is still verified.
  pinLookup      String?      @unique @map("pin_lookup")
  pinGeneratedAt DateTime?    @map("pin_generated_at")
  status         MemberStatus @default(ACTIVE)
  lastLoginAt    DateTime?    @map("last_login_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships         CommitteeMembership[]
  sessions            Session[]
  attendance          MeetingAttendance[]
  assignedTasks       Task[]                @relation("TaskAssignee")
  createdTasks        Task[]                @relation("TaskCreatorMember")
  completedTasks      Task[]                @relation("TaskCompleter")
  preparedMinutes     MeetingMinutes[]      @relation("MinutesPreparedBy")
  approvedMinutes     MeetingMinutes[]      @relation("MinutesApprovedBy")
  uploadedDocuments   Document[]            @relation("DocUploaderMember")
  createdMeetings     Meeting[]             @relation("MeetingCreatorMember")
  motionsMoved        Motion[]              @relation("MotionMovedBy")
  motionsSeconded     Motion[]              @relation("MotionSecondedBy")
  minuteRevisions     MeetingMinuteRevision[]
  auditLogs           AuditLog[]

  @@index([organizationId, status])
  @@index([lastName, firstName])
  @@map("members")
}

model CommitteeMembership {
  id                String        @id @default(uuid()) @db.Uuid
  committeeId       String        @map("committee_id") @db.Uuid
  memberId          String        @map("member_id") @db.Uuid
  role              CommitteeRole @default(MEMBER)
  /// Committee position title shown in the directory (e.g. "Treasurer"). Optional.
  position          String?
  /// Administrator may allow a secretary to publish minutes.
  canPublishMinutes Boolean       @default(false) @map("can_publish_minutes")
  isActive          Boolean       @default(true) @map("is_active")
  joinedAt          DateTime      @default(now()) @map("joined_at")
  leftAt            DateTime?     @map("left_at")

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([committeeId, memberId])
  @@index([memberId, isActive])
  // "One active chair per committee" is additionally enforced by a partial unique index
  // created in the migration: committee_memberships_one_active_chair.
  @@map("committee_memberships")
}

model Meeting {
  id                   String        @id @default(uuid()) @db.Uuid
  committeeId          String        @map("committee_id") @db.Uuid
  title                String
  meetingType          MeetingType   @default(REGULAR) @map("meeting_type")
  meetingDate          DateTime      @map("meeting_date") @db.Date
  startTime            String?       @map("start_time") // "HH:MM" 24h
  endTime              String?       @map("end_time")
  location             String?
  description          String?
  notes                String?
  status               MeetingStatus @default(SCHEDULED)
  createdByMemberId    String?       @map("created_by") @db.Uuid
  createdByAdminId     String?       @map("created_by_admin") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  committee       Committee           @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  createdByMember Member?             @relation("MeetingCreatorMember", fields: [createdByMemberId], references: [id])
  createdByAdmin  AdminUser?          @relation("MeetingCreatorAdmin", fields: [createdByAdminId], references: [id])
  attendance      MeetingAttendance[]
  agendaItems     AgendaItem[]
  minutes         MeetingMinutes?
  tasks           Task[]
  documents       Document[]

  @@index([committeeId, meetingDate])
  @@index([meetingDate])
  @@map("meetings")
}

model MeetingAttendance {
  id               String           @id @default(uuid()) @db.Uuid
  meetingId        String           @map("meeting_id") @db.Uuid
  memberId         String?          @map("member_id") @db.Uuid
  attendeeName     String           @map("attendee_name")
  attendanceStatus AttendanceStatus @map("attendance_status")
  notes            String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  Member? @relation(fields: [memberId], references: [id])

  @@unique([meetingId, memberId])
  @@index([meetingId])
  @@map("meeting_attendance")
}

model AgendaItem {
  id           String        @id @default(uuid()) @db.Uuid
  meetingId    String        @map("meeting_id") @db.Uuid
  section      AgendaSection
  title        String
  description  String?
  displayOrder Int           @map("display_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  meeting   Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([meetingId, displayOrder])
  @@map("agendas")
}

model MeetingMinutes {
  id               String        @id @default(uuid()) @db.Uuid
  meetingId        String        @unique @map("meeting_id") @db.Uuid
  status           MinutesStatus @default(DRAFT)
  chairpersonName  String?       @map("chairperson_name")
  secretaryName    String?       @map("secretary_name")
  callToOrder      String?       @map("call_to_order")
  previousMinutes  String?       @map("previous_minutes")
  oldBusiness      String?       @map("old_business")
  newBusiness      String?       @map("new_business")
  committeeReports String?       @map("committee_reports")
  projectUpdates   String?       @map("project_updates")
  recommendations  String?
  otherBusiness    String?       @map("other_business")
  adjournmentTime  String?       @map("adjournment_time")
  closingNotes     String?       @map("closing_notes")
  reviewComments   String?       @map("review_comments")
  preparedById     String?       @map("prepared_by") @db.Uuid
  preparedByAdminId String?      @map("prepared_by_admin") @db.Uuid
  submittedAt      DateTime?     @map("submitted_at")
  approvedById     String?       @map("approved_by") @db.Uuid
  approvedByAdminId String?      @map("approved_by_admin") @db.Uuid
  approvedByName   String?       @map("approved_by_name")
  approvedAt       DateTime?     @map("approved_at")
  publishedAt      DateTime?     @map("published_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  meeting         Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  preparedBy      Member?                 @relation("MinutesPreparedBy", fields: [preparedById], references: [id])
  approvedBy      Member?                 @relation("MinutesApprovedBy", fields: [approvedById], references: [id])
  preparedByAdmin AdminUser?              @relation("MinutesPreparedByAdmin", fields: [preparedByAdminId], references: [id])
  approvedByAdmin AdminUser?              @relation("MinutesApprovedByAdmin", fields: [approvedByAdminId], references: [id])
  motions         Motion[]
  revisions       MeetingMinuteRevision[]

  @@index([status])
  @@map("meeting_minutes")
}

model Motion {
  id            String         @id @default(uuid()) @db.Uuid
  minutesId     String         @map("minutes_id") @db.Uuid
  description   String
  movedById     String?        @map("moved_by") @db.Uuid
  movedByName   String?        @map("moved_by_name")
  secondedById  String?        @map("seconded_by") @db.Uuid
  secondedByName String?       @map("seconded_by_name")
  votesFor      Int            @default(0) @map("votes_for")
  votesAgainst  Int            @default(0) @map("votes_against")
  abstentions   Int            @default(0)
  outcome       MotionOutcome  @default(PASSED)
  notes         String?
  displayOrder  Int            @default(0) @map("display_order")
  createdAt     DateTime       @default(now()) @map("created_at")

  minutes    MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  movedBy    Member?        @relation("MotionMovedBy", fields: [movedById], references: [id])
  secondedBy Member?        @relation("MotionSecondedBy", fields: [secondedById], references: [id])

  @@index([minutesId])
  @@map("motions")
}

model Task {
  id                  String       @id @default(uuid()) @db.Uuid
  committeeId         String       @map("committee_id") @db.Uuid
  meetingId           String?      @map("meeting_id") @db.Uuid
  title               String
  description         String?
  assignedMemberId    String?      @map("assigned_member_id") @db.Uuid
  createdByMemberId   String?      @map("created_by") @db.Uuid
  createdByAdminId    String?      @map("created_by_admin") @db.Uuid
  priority            TaskPriority @default(NORMAL)
  status              TaskStatus   @default(NOT_STARTED)
  dueDate             DateTime?    @map("due_date") @db.Date
  completedAt         DateTime?    @map("completed_at")
  completedByMemberId String?      @map("completed_by") @db.Uuid
  completedByName     String?      @map("completed_by_name")
  completionNotes     String?      @map("completion_notes")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  committee       Committee  @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  meeting         Meeting?   @relation(fields: [meetingId], references: [id])
  assignedMember  Member?    @relation("TaskAssignee", fields: [assignedMemberId], references: [id])
  createdByMember Member?    @relation("TaskCreatorMember", fields: [createdByMemberId], references: [id])
  createdByAdmin  AdminUser? @relation("TaskCreatorAdmin", fields: [createdByAdminId], references: [id])
  completedBy     Member?    @relation("TaskCompleter", fields: [completedByMemberId], references: [id])
  documents       Document[]

  @@index([committeeId, status])
  @@index([assignedMemberId, status])
  @@index([dueDate])
  @@map("tasks")
}

model Document {
  id                 String           @id @default(uuid()) @db.Uuid
  committeeId        String           @map("committee_id") @db.Uuid
  meetingId          String?          @map("meeting_id") @db.Uuid
  agendaItemId       String?          @map("agenda_item_id") @db.Uuid
  taskId             String?          @map("task_id") @db.Uuid
  /// Supporting file for an architectural request (not shown in the general library).
  arbRequestId       String?          @map("arb_request_id") @db.Uuid
  arbDocType         ArbDocType?      @map("arb_doc_type")
  /// Set when a resident uploaded the file through their tracking link.
  uploadedByResident String?          @map("uploaded_by_resident")
  title              String
  description        String?
  /// Null = "Unfiled" (e.g. after its folder was removed).
  folderId           String?          @map("folder_id") @db.Uuid
  originalFilename   String           @map("original_filename")
  storageKey         String           @unique @map("storage_key")
  mimeType           String           @map("mime_type")
  fileSize           Int              @map("file_size")
  uploadedByMemberId String?          @map("uploaded_by") @db.Uuid
  uploadedByAdminId  String?          @map("uploaded_by_admin") @db.Uuid
  /// Soft delete: removed documents stay in storage and the audit trail.
  removedAt          DateTime?        @map("removed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  committee        Committee       @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  folder           DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  meeting          Meeting?    @relation(fields: [meetingId], references: [id])
  agendaItem       AgendaItem? @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  task             Task?       @relation(fields: [taskId], references: [id])
  arbRequest       ArbRequest? @relation(fields: [arbRequestId], references: [id])
  uploadedByMember Member?     @relation("DocUploaderMember", fields: [uploadedByMemberId], references: [id])
  uploadedByAdmin  AdminUser?  @relation("DocUploaderAdmin", fields: [uploadedByAdminId], references: [id])

  @@index([committeeId, folderId, removedAt])
  @@index([meetingId])
  @@index([taskId])
  @@index([arbRequestId])
  @@map("documents")
}

/// Document library folders. Each committee has its own; the chair or an administrator manages them.
model DocumentFolder {
  id           String   @id @default(uuid()) @db.Uuid
  committeeId  String   @map("committee_id") @db.Uuid
  name         String
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  committee Committee  @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  documents Document[]

  @@unique([committeeId, name])
  @@index([committeeId, displayOrder])
  @@map("document_folders")
}

/// An architectural review request submitted by a resident (or entered by the ARB).
model ArbRequest {
  id                String           @id @default(uuid()) @db.Uuid
  committeeId       String           @map("committee_id") @db.Uuid
  referenceNumber   String           @unique @map("reference_number") // e.g. ARB-2026-0007
  status            ArbStatus        @default(SUBMITTED)
  applicantName     String           @map("applicant_name")
  applicantEmail    String?          @map("applicant_email")
  applicantPhone    String?          @map("applicant_phone")
  propertyAddress   String           @map("property_address")
  lotNumber         String?          @map("lot_number")
  projectType       ArbProjectType   @map("project_type")
  description       String
  contractorName    String?          @map("contractor_name")
  estimatedStart    DateTime?        @map("estimated_start") @db.Date
  estimatedFinish   DateTime?        @map("estimated_finish") @db.Date
  waterLine         UtilityPlacement @default(UNKNOWN) @map("water_line")
  gasLine           UtilityPlacement @default(UNKNOWN) @map("gas_line")
  electricLine      UtilityPlacement @default(UNKNOWN) @map("electric_line")
  utilityNotes      String?          @map("utility_notes")
  /// Decision text shown to the resident (conditions of approval or reason for denial).
  decisionNotes     String?          @map("decision_notes")
  decidedAt         DateTime?        @map("decided_at")
  decidedByName     String?          @map("decided_by_name")
  completedAt       DateTime?        @map("completed_at")
  /// HMAC of the resident's private tracking token. The token itself is never stored.
  accessTokenHash   String           @unique @map("access_token_hash")
  submittedByStaff  String?          @map("submitted_by_staff")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  committee Committee         @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  documents Document[]
  events    ArbRequestEvent[]

  @@index([committeeId, status])
  @@index([propertyAddress])
  @@map("arb_requests")
}

/// Progress history: stage changes, messages to/from the resident, internal notes, uploads.
model ArbRequestEvent {
  id                String     @id @default(uuid()) @db.Uuid
  requestId         String     @map("request_id") @db.Uuid
  kind              String     // STATUS_CHANGE | MESSAGE | NOTE | DOCUMENT | RESIDENT
  fromStatus        ArbStatus? @map("from_status")
  toStatus          ArbStatus? @map("to_status")
  message           String?
  visibleToResident Boolean    @default(false) @map("visible_to_resident")
  actorName         String     @map("actor_name")
  actorMemberId     String?    @map("actor_member_id") @db.Uuid
  actorAdminId      String?    @map("actor_admin_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")

  request ArbRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("arb_request_events")
}

model MeetingMinuteRevision {
  id             String   @id @default(uuid()) @db.Uuid
  minutesId      String   @map("minutes_id") @db.Uuid
  revisionNumber Int      @map("revision_number")
  snapshotJson   Json     @map("snapshot_json")
  changedById    String?  @map("changed_by") @db.Uuid
  changedByAdminId String? @map("changed_by_admin") @db.Uuid
  changedByName  String?  @map("changed_by_name")
  changeReason   String?  @map("change_reason")
  createdAt      DateTime @default(now()) @map("created_at")

  minutes        MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Restrict)
  changedBy      Member?        @relation(fields: [changedById], references: [id])
  changedByAdmin AdminUser?     @relation(fields: [changedByAdminId], references: [id])

  @@unique([minutesId, revisionNumber])
  @@map("meeting_minute_revisions")
}

/// An HOA's own administrator. Each one belongs to exactly one HOA.
model AdminUser {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  email          String
  passwordHash   String      @map("password_hash")
  name         String
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?   @map("last_login_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  sessions         Session[]
  meetings         Meeting[]               @relation("MeetingCreatorAdmin")
  tasks            Task[]                  @relation("TaskCreatorAdmin")
  documents        Document[]              @relation("DocUploaderAdmin")
  preparedMinutes  MeetingMinutes[]        @relation("MinutesPreparedByAdmin")
  approvedMinutes  MeetingMinutes[]        @relation("MinutesApprovedByAdmin")
  minuteRevisions  MeetingMinuteRevision[]
  auditLogs        AuditLog[]
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, email])
  @@map("admin_users")
}

model Session {
  id                String     @id @default(uuid()) @db.Uuid
  memberId          String?    @map("member_id") @db.Uuid
  adminUserId       String?    @map("admin_user_id") @db.Uuid
  platformUserId    String?    @map("platform_user_id") @db.Uuid
  /// SHA-256 of the random session token; the raw token only lives in the HTTP-only cookie.
  tokenHash         String     @unique @map("token_hash")
  activeCommitteeId String?    @map("active_committee_id") @db.Uuid
  expiresAt         DateTime   @map("expires_at")
  lastSeenAt        DateTime   @default(now()) @map("last_seen_at")
  ipAddress         String?    @map("ip_address")
  userAgent         String?    @map("user_agent")
  createdAt         DateTime   @default(now()) @map("created_at")

  member       Member?       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  adminUser    AdminUser?    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([platformUserId])
  @@index([adminUserId])
  @@index([expiresAt])
  @@map("sessions")
}

/// The software's owner (you): manages every HOA from the owner console. Not tied to any HOA.
model PlatformUser {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?   @map("last_login_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  sessions Session[]

  @@map("platform_users")
}

/// Failed/successful login attempts, used for rate limiting and temporary lockouts.
/// Stored in Postgres so limits hold across multiple app instances and restarts.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorMemberId  String?  @map("actor_member_id") @db.Uuid
  actorAdminId   String?  @map("actor_admin_id") @db.Uuid
  actorName      String?  @map("actor_name")
  committeeId    String?  @map("committee_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  detailsJson    Json?    @map("details_json")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorMember  Member?      @relation(fields: [actorMemberId], references: [id])
  actorAdmin   AdminUser?   @relation(fields: [actorAdminId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([committeeId, createdAt])
  @@map("audit_logs")
}
