# ---- Database (Render PostgreSQL "Internal Database URL") ----
DATABASE_URL=postgresql://hoa:hoa@localhost:5432/hoa_portal

# ---- Secrets: generate each with `openssl rand -hex 32` ----
# Signs/protects member sessions
SESSION_SECRET=
# Protects administrator sessions
ADMIN_AUTH_SECRET=
# Keyed HMAC used to look up PINs (PINs themselves are stored as Argon2id hashes).
# WARNING: changing this invalidates every existing PIN.
PIN_HASH_SECRET=

# ---- File storage: EITHER a persistent disk folder... ----
# On Render: attach a Persistent Disk at /var/data and set UPLOAD_DIR=/var/data/uploads
UPLOAD_DIR=

# ---- ...OR S3-compatible object storage (takes priority when set) (Cloudflare R2, AWS S3, Backblaze B2, Wasabi...) ----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Set to "true" for MinIO and some other providers
S3_FORCE_PATH_STYLE=false

# ---- Multiple HOAs ----
# Your brand's domain. Each HOA gets <slug>.ROOT_DOMAIN; the bare domain shows the main site + owner console.
# Leave empty for single-HOA mode (every address shows the first HOA). Locally you can use ROOT_DOMAIN=localhost
# and open http://<slug>.localhost:3000 in Chrome.
ROOT_DOMAIN=
PLATFORM_NAME=HOA Committee Portal
SALES_EMAIL=
DEFAULT_ORG_SLUG=

# ---- App ----
APP_URL=http://localhost:3000
NODE_ENV=development

# One-time token that unlocks /admin/setup to create the first administrator.
# The page only works while no administrator exists. Remove after setup.
SETUP_TOKEN=

# Development only: store uploads on local disk when S3 is not configured.
# Never enabled in production.
ALLOW_LOCAL_STORAGE=true
